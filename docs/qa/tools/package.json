{
  "name": "louwietec-qa-tools",
  "private": true,
  "type": "module",
  "description": "Dev-only Prüf- und Erzeugungsskripte für die LOUWIETEC-Website. Erzeugen keine Seiten; die Site braucht keinen Build.",
  "scripts": {
    "check:partials": "node check-partials.mjs",
    "fix:partials": "node check-partials.mjs --fix",
    "check:hausgesetze": "node check-verify-green.mjs",
    "make:brand": "node make-brand.mjs",
    "font:metrics": "node font-metrics.mjs",
    "check:copy": "node diff-copy.mjs",
    "check:links": "node check-links.mjs",
    "screens": "node screens.mjs",
    "make:frames": "node make-dummy-frames.mjs",
    "check:contract": "node check-contract.mjs",
    "test:integration": "node integration.spec.mjs",
    "test:integration:live": "LW_LIVE=1 node integration.spec.mjs"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "node-html-parser": "^7.0.1",
    "diff": "^8.0.2"
  }
}
